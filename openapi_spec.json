{
  "openapi": "3.1.0",
  "info": {
    "title": "Rockall UGIB Score API",
    "version": "1.1.0",
    "description": "Local Rockall scoring endpoint and optional legacy audit/chat utilities. Rockall cohort rates are historical frequencies, not individual risk estimates."
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Serve standalone Rockall calculator",
        "responses": {
          "200": {
            "description": "Static HTML calculator",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service health metadata"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Local process metrics",
        "responses": {
          "200": {
            "description": "JSON counters and status"
          }
        }
      }
    },
    "/api/score": {
      "post": {
        "summary": "Calculate clinical and complete Rockall scores from available findings",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Score components, completeness flags, available totals and historical outcome frequencies"
          },
          "422": {
            "description": "Invalid or inconsistent score input"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy non-clinical audit utility",
        "description": "A generic threshold demo, not UGIB score logic. Protected network use only.",
        "responses": {
          "200": {
            "description": "Audit dossier"
          },
          "422": {
            "description": "Invalid input or sensitive identifier"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Legacy deterministic mock reply",
        "description": "Does not perform scientific verification or score calculation.",
        "responses": {
          "200": {
            "description": "Mock reply"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Legacy in-memory HMAC audit log",
        "description": "Disabled unless ENABLE_AUDIT_LOGS=1; not durable or access controlled.",
        "responses": {
          "200": {
            "description": "Audit chain"
          },
          "403": {
            "description": "Audit logs disabled"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ScoreRequest": {
        "type": "object",
        "properties": {
          "age": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 150
          },
          "shock_hr": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "maximum": 300
          },
          "shock_sbp": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "maximum": 300
          },
          "comorbidity": {
            "type": "string",
            "default": "none",
            "description": "none, cardiac, other_major, major and recognized aliases"
          },
          "endoscopic_diagnosis": {
            "type": [
              "string",
              "null"
            ],
            "description": "none, mallory_weiss, other, peptic_ulcer, cancer and recognized aliases"
          },
          "major_stigmata": {
            "type": [
              "string",
              "null"
            ],
            "description": "none, dark_spot, blood, visible_vessel, active_bleeding and recognized aliases"
          }
        }
      }
    }
  }
}
